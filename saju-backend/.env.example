# --- Server ---
PORT=3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/saju_db

# --- Image Generation Provider ---
# 정식 REST API를 쓰는 프로바이더로 교체 가능 (Stability AI 예시 사용)
IMAGE_PROVIDER=stability
STABILITY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
STABILITY_API_HOST=https://api.stability.ai
STABILITY_ENGINE_ID=stable-diffusion-xl-1024-v1-0

# --- Cloud Storage (크롭된 webp 업로드용, 예: S3 호환) ---
STORAGE_BUCKET_URL=https://saju-app-assets.s3.amazonaws.com
STORAGE_ACCESS_KEY=xxxxx
STORAGE_SECRET_KEY=xxxxx

# --- TTL 정책 ---
DAILY_IMAGE_TTL_DAYS=7
